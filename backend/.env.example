# ---------- Neon (serverless Postgres) ----------
# Neon gives you TWO connection strings. Use both.
#   DATABASE_URL -> the POOLED one  (host contains "-pooler")  — used by the app
#   DIRECT_URL   -> the DIRECT one  (no "-pooler")             — used by migrations
# Prisma migrations fail over PgBouncer, which is why the second one exists.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------- Server ----------
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ---------- Auth ----------
# Generate: openssl rand -base64 48
JWT_SECRET="replace-me"
JWT_EXPIRE="15m"
JWT_REFRESH_DAYS=30

# ---------- Encryption for Google OAuth tokens at rest ----------
# Must be exactly 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY="replace-me-64-hex-chars"

# ---------- Google OAuth / Calendar (optional) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Enable the "Google Calendar API" for the project first.
# Add GOOGLE_REDIRECT_URI verbatim to the client's Authorised redirect URIs.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# Where the OAuth callback sends the browser back to, and the link embedded in
# each calendar event description.
APP_URL="http://localhost:3000"

# Push notifications (optional). Google only accepts HTTPS on a verified
# domain, so leave this empty in local dev — the app falls back to hourly
# polling automatically instead of failing.
GOOGLE_WEBHOOK_URL=""

# Set to "true" on extra instances so only one runs the watch-renewal cron.
DISABLE_CALENDAR_JOBS="false"
